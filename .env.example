# ==============================================================================
# KRYPHIX PRIVACY PLATFORM — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. Environment & Server Ports
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_BASE_URL=https://kryphix.my.id
NEXT_PUBLIC_ADMIN_URL=https://nexus-console.kryphix.my.id
SESSION_SECRET=kryphix_super_secret_session_key_min_32_chars_2026

# 2. Database (PostgreSQL 16+)
DB_USER=kryphix_admin
DB_PASSWORD=kryphix_secure_db_password_2026
DB_NAME=kryphix_prod
DATABASE_URL=postgresql://kryphix_admin:kryphix_secure_db_password_2026@localhost:5432/kryphix_prod?schema=public

# 3. Redis 7+ In-Memory Cache & Pub/Sub
REDIS_URL=redis://localhost:6379

# 4. Local MinIO S3 Object Storage (Zero-Cost Local NVMe Storage)
MINIO_ROOT_USER=kryphix_minio_user
MINIO_ROOT_PASSWORD=kryphix_minio_secret_key_2026
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=kryphix_minio_user
S3_SECRET_KEY=kryphix_minio_secret_key_2026
S3_BUCKET_NAME=kryphix-vault-blobs
S3_REGION=us-east-1

# 5. Cloudflare Tunnel (100% Free CGNAT Bypass)
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiZXhhbXBsZS10b2tlbi1mcm9tLWNsb3VkZmxhcmUtdmVyaWZ5In0=

# 6. Payment Gateway Midtrans (Snap API)
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SANDBOX_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_SANDBOX_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=G123456789

# 7. Dual-Layer Master Admin Key Escrow (RSA-OAEP 4096-bit)
# Public key disematkan di server untuk membungkus adminWrappedDek
MASTER_ADMIN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEA...\n-----END PUBLIC KEY-----"
# Private key HANYA dipegang oleh Superadmin dan tidak pernah disimpan di repository
# MASTER_ADMIN_PRIVATE_KEY=""

# 8. Superadmin Nexus Security Gate
ADMIN_IP_WHITELIST=127.0.0.1,::1,192.168.1.0/24
ADMIN_INITIAL_EMAIL=admin@kryphix.my.id
ADMIN_INITIAL_PASSWORD=KryphixRootAdminPass2026!
ADMIN_INITIAL_TOTP_SECRET=JBSWY3DPEHPK3PXP

