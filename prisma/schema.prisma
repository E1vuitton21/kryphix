model ShredCertificate {
  id                 String       @id @default(uuid()) @db.Uuid
  certificateCode    String       @unique @map("certificate_code") @db.VarChar(64)
  resourceType       String       @map("resource_type") @db.VarChar(50)
  resourceId         String       @map("resource_id") @db.Uuid
  fingerprintSha256  String       @map("fingerprint_sha256") @db.VarChar(64)
  nonce              String       @db.VarChar(64)
  shredMethod        String       @default("DOD_5220_22_M_RAM_ZERO") @map("shred_method") @db.VarChar(50)
  shreddedAt         DateTime     @default(now()) @map("shredded_at") @db.Timestamptz
  caSignatureEd25519 String       @map("ca_signature_ed25519") @db.Text
  issuedToVisitorId  String?      @map("issued_to_visitor_id") @db.Uuid
  verificationCount  Int          @default(0) @map("verification_count")
  lastVerifiedAt     DateTime?    @map("last_verified_at") @db.Timestamptz
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz

  issuedToVisitor    VisitorTrack? @relation(fields: [issuedToVisitorId], references: [visitorId], onDelete: SetNull)

  @@map("shred_certificates")
}

model CanaryTrap {
  id            String            @id @default(uuid()) @db.Uuid
  documentTitle String            @map("document_title") @db.VarChar(255)
  baseHashSha256 String           @map("base_hash_sha256") @db.VarChar(64)
  ownerUserId   String            @map("owner_user_id") @db.Uuid
  recipientCount Int              @map("recipient_count")
  status        String            @default("ACTIVE") @db.VarChar(30)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz

  ownerUser     User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  recipients    CanaryRecipient[]
  leakLogs      CanaryLeakLog[]

  @@index([ownerUserId], name: "idx_canary_traps_user")
  @@map("canary_traps")
}

model CanaryRecipient {
  id               String       @id @default(uuid()) @db.Uuid
  trapId           String       @map("trap_id") @db.Uuid
  recipientLabel   String       @map("recipient_label") @db.VarChar(128)
  binarySignature  String       @map("binary_signature") @db.VarChar(64)
  zeroWidthPayload String       @map("zero_width_payload") @db.Text
  viewToken        String       @unique @map("view_token") @db.VarChar(64)
  firstAccessedAt  DateTime?    @map("first_accessed_at") @db.Timestamptz
  visitorId        String?      @map("visitor_id") @db.Uuid
  accessIp         String?      @map("access_ip") @db.VarChar(45)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz

  trap             CanaryTrap   @relation(fields: [trapId], references: [id], onDelete: Cascade)
  visitor          VisitorTrack? @relation(fields: [visitorId], references: [visitorId], onDelete: SetNull)
  leakLogs         CanaryLeakLog[]

  @@index([trapId], name: "idx_canary_recipients_trap")
  @@map("canary_recipients")
}

model CanaryLeakLog {
  id                 BigInt          @id @default(autoincrement())
  trapId             String          @map("trap_id") @db.Uuid
  matchedRecipientId String          @map("matched_recipient_id") @db.Uuid
  investigatorIp     String          @map("investigator_ip") @db.VarChar(45)
  detectedBinary     String          @map("detected_binary") @db.VarChar(64)
  confidenceScore    Decimal         @map("confidence_score") @db.Decimal(5, 2)
  investigatedAt     DateTime        @default(now()) @map("investigated_at") @db.Timestamptz

  trap               CanaryTrap      @relation(fields: [trapId], references: [id], onDelete: Cascade)
  matchedRecipient   CanaryRecipient @relation(fields: [matchedRecipientId], references: [id], onDelete: Cascade)

  @@map("canary_leak_logs")
}

model CliPipe {
  id              String   @id @default(uuid()) @db.Uuid
  pipeSlug        String   @unique @map("pipe_slug") @db.VarChar(32)
  encryptedPayload Bytes   @map("encrypted_payload")
  sizeBytes       Int      @map("size_bytes")
  burnAfterRead   Boolean  @default(true) @map("burn_after_read")
  downloadCount   Int      @default(0) @map("download_count")
  maxDownloads    Int      @default(1) @map("max_downloads")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz
  createdIp       String   @map("created_ip") @db.VarChar(45)
  userAgent       String?  @map("user_agent") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([expiresAt], name: "idx_cli_pipes_sweep")
  @@map("cli_pipes")
}

model TimelockVault {
  id                 String   @id @default(uuid()) @db.Uuid
  vaultSlug          String   @unique @map("vault_slug") @db.VarChar(32)
