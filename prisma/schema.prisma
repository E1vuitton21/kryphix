}

model SanitizerTelemetry {
  id                    BigInt        @id @default(autoincrement())
  visitorId             String?       @map("visitor_id") @db.Uuid
  entitiesRedactedCount Int           @map("entities_redacted_count")
  apiKeysCount          Int           @default(0) @map("api_keys_count")
  piiCount              Int           @default(0) @map("pii_count")
