  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  ownerUser          User?    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([targetReleaseTime], name: "idx_timelock_target_time")
  @@map("timelock_vaults")
}

model VoiceMemo {
  id               String    @id @default(uuid()) @db.Uuid
  memoSlug         String    @unique @map("memo_slug") @db.VarChar(32)
  durationSeconds  Int       @map("duration_seconds")
  scramblerProfile String    @map("scrambler_profile") @db.VarChar(30)
  encryptedAudioBlob Bytes   @map("encrypted_audio_blob")
  isBurned         Boolean   @default(false) @map("is_burned")
  playedAt         DateTime? @map("played_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  ownerUserId      String?   @map("owner_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  ownerUser        User?     @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([isBurned, expiresAt], name: "idx_voice_memos_sweep")
